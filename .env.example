# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi (.gitignore da).

# Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-insecure-key-almashtiring

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Produksiyada domeningiz, masalan: https://nurjahon.uz
CSRF_TRUSTED_ORIGINS=
SITE_DOMAIN=127.0.0.1:8000

# Kontakt formasidan kelgan xabarlar shu manzilga yuboriladi (bo'sh bo'lsa yuborilmaydi).
CONTACT_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=portfolio@example.com

# DEBUG=False bo'lganda ishlatiladi (Gmail uchun "App password" kerak)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
