# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi (.gitignore da).

# Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-insecure-key-almashtiring

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Produksiyada domeningiz, masalan: https://nurjahon.uz
CSRF_TRUSTED_ORIGINS=
SITE_DOMAIN=127.0.0.1:8000

# ------------------------------------------------------------------ Telegram
# Kontakt formasidan kelgan xabar to'g'ridan-to'g'ri Telegram'ga tushadi.
# Ikkalasi to'ldirilmasa — yuborilmaydi (sayt baribir ishlayveradi).
#   1) @BotFather -> /newbot -> token
#   2) Botingizga Telegram'da /start bosing (shart!), keyin:
#        python manage.py telegram_chat_id
#      chiqqan raqamni TELEGRAM_CHAT_ID ga yozing.
# Diqqat: bu yerga @username yozib bo'lmaydi, faqat raqamli ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kontakt formasidan kelgan xabarlar shu manzilga yuboriladi (bo'sh bo'lsa yuborilmaydi).
CONTACT_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=portfolio@example.com

# Quyidagi ikkitasi to'ldirilsa — xat haqiqatan yuboriladi.
# Bo'sh qolsa — xat terminalga (konsolga) chiqadi, sayt baribir ishlayveradi.
# Gmail uchun oddiy parol emas, "App password" kerak:
#   Google akkaunt → Security → 2-Step Verification (yoqing) → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --------------------------------------------------------------- produksiya
# Quyidagilar lokalda kerak emas. Railway'da Variables bo'limiga qo'yiladi.

# Baza va media fayllar saqlanadigan doimiy papka (Railway Volume mount yo'li).
# Bo'sh qolsa — loyiha papkasining o'zi ishlatiladi (lokal uchun shunday).
DATA_DIR=

# Sayt reverse-proxy ortida (Railway, nginx, Cloudflare) tursa — True.
TRUST_PROXY_IP=False

# Yuklangan rasmlarni Django o'zi bersinmi. S3/Cloudinary ulasangiz — False.
SERVE_MEDIA=True
